{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/index.js",
    "format": "prettier --write src package.json tsconfig.json vitest.config.ts README.md --ignore-unknown",
    "lint": "oxlint src vitest.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
