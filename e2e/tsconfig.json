{
  "include": ["tests/**/*", "playwright.config.ts"],
  "compilerOptions": {
    "lib": ["DOM", "ES2022"],
    "types": ["node"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  }
}
