{
  "name": "good-vibes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "e2e:report": "playwright show-report",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write app e2e *.ts package.json tsconfig.json README.md --ignore-unknown --no-error-on-unmatched-pattern",
    "lint": "oxlint app e2e react-router.config.ts vite.config.ts vitest.config.ts playwright.config.ts",
    "precommit": "pnpm format && pnpm lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@earendil-works/pi-agent-core": "^1.0.4",
    "@earendil-works/pi-ai": "^1.0.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@shadcn/react": "^0.3.1",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "effect": "4.0.0-rc.117",
    "immer": "^11.1.21",
    "isbot": "^5.1.36",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.0",
    "tone": "^15.1.22",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.2",
    "web-audio-api": "^1.5.6"
  }
}
