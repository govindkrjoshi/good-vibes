{
  "name": "good-vibes",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./backend --filter ./frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter backend test",
    "test:frontend": "pnpm --filter frontend test",
    "start:backend": "pnpm --filter backend start",
    "start:frontend": "pnpm --filter frontend start",
    "typecheck": "pnpm --filter frontend typecheck",
    "format": "pnpm --filter backend format && pnpm --filter frontend format",
    "lint": "pnpm --filter backend lint && pnpm --filter frontend lint",
    "precommit": "pnpm format && pnpm lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9"
  }
}
